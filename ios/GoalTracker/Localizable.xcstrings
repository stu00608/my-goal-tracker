    "Condition reminders require a location condition and cannot include health conditions. Time and weekday conditions are checked when a location event occurs.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Condition reminders require a location condition and cannot include health conditions. Time and weekday conditions are checked when a location event occurs."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "條件提醒需要位置條件，且不能包含健康條件。位置變動時會一併檢查時間與星期條件。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "条件の通知には位置条件が必要で、健康条件は含められません。位置の変化時に時間と曜日も確認します。"
          }
        }
      }
    },
    "Condition reminders use location events and need Always location access. They never create records automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Condition reminders use location events and need Always location access. They never create records automatically."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "條件提醒在位置變動時檢查，需要「永遠」位置權限；不會自動建立紀錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "条件の通知は位置の変化時に確認するため、位置情報の「常に許可」が必要です。記録は自動作成されません。"
          }
        }
      }
    },
