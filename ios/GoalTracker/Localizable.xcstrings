    "Strict comparison: equality does not meet the condition. Uses readable Apple Health data from the calendar period’s start through now.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strict comparison: equality does not meet the condition. Uses readable Apple Health data from the calendar period’s start through now."
          }
        },
