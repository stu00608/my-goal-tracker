      }
    },
    "Could not read Apple Health data. It will update automatically when available.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not read Apple Health data. It will update automatically when available."
