    "Location reminders need Always location access. They never create records automatically.": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "位置提醒需要「永遠」存取位置，不會自動建立紀錄。"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "位置の通知には位置情報の「常に」の許可が必要です。記録が自動で作成されることはありません。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Location reminders need Always location access. They never create records automatically."
          }
        }
