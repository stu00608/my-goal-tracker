    "This change would leave later records without a baseline. Convert the first affected record to its previous value %@ and recalculate following changes?": {
      "extractionState": "manual",
      "localizations": {
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此操作會讓後續紀錄失去基準。是否將首筆受影響的紀錄轉成操作前的數值 %@，並重新計算後續變化值？"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この操作により後続の記録の基準が失われます。最初の対象記録を操作前の値 %@ に変換し、後続の変化量を再計算しますか？"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This change would leave later records without a baseline. Convert the first affected record to its previous value %@ and recalculate following changes?"
          }
        }
      }
    },
