        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "過去の日付の記録でも、条件は現在の時刻で判定します。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即使補登過去的紀錄，條件仍以當下時間判定。"
          }
        }
      }
    },
    "Based on readable Apple Health data so far in this calendar period. Sleep is clipped to the period, not grouped by wake-up.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Based on readable Apple Health data so far in this calendar period. Sleep is clipped to the period, not grouped by wake-up."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間で現在までに読み取れるAppleヘルスケアのデータに基づきます。睡眠は期間内の時間だけを集計し、起床日ではまとめません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "依據此日曆期間至目前可讀取的 Apple 健康資料。睡眠只計算期間內的部分，不依起床日歸組。"
          }
        }
      }
