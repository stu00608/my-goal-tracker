    "Checking health access…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking health access…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアの設定を確認中…"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在確認健康資料設定⋯"
          }
        }
      }
    },
    "Connect to use the health data selected for your conditions. Only the selected types are requested.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect to use the health data selected for your conditions. Only the selected types are requested."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "条件に使用する健康データを連携します。選択したデータの種類のみアクセスを求めます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連接條件所使用的健康資料。只會要求讀取你選擇的資料類型。"
          }
        }
      }
    },
    "Manage health access": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage health access"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアへのアクセス"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "健康資料存取"
          }
        }
      }
    },
    "In Apple Health, tap your profile, then Apps and Goalooker to review steps and sleep read access.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In Apple Health, tap your profile, then Apps and Goalooker to review steps and sleep read access."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアでプロフィールをタップし、「アプリ」から Goalooker を選んで歩数と睡眠の読み取り設定を確認してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在「健康」App 點選個人檔案，再到「App」選擇 Goalooker，確認步數與睡眠的讀取權限。"
          }
        }
      }
    },
    "No readable samples can mean there is no data yet or read access is off. Apple Health keeps these cases private; Goalooker never assumes zero.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No readable samples can mean there is no data yet or read access is off. Apple Health keeps these cases private; Goalooker never assumes zero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取れるデータがない場合、まだ記録がないか、読み取りがオフになっている可能性があります。ヘルスケアでは区別できないため、Goalooker はゼロとみなしません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有可讀取樣本，可能是尚未產生資料，或讀取權限未開啟。Apple 健康不會揭露兩者的差別，Goalooker 不會直接視為 0。"
          }
        }
      }
    },
    "No readable samples yet in this period. Apple Health does not distinguish an empty period from disabled read access.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No readable samples yet in this period. Apple Health does not distinguish an empty period from disabled read access."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この期間に読み取れる記録はまだありません。記録がない場合と読み取りがオフの場合は区別できません。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這段期間還沒有可讀取的樣本；可能尚未產生資料，也可能讀取權限未開啟。"
          }
        }
      }
    },
    "Set up Apple Health in this tracker’s settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set up Apple Health in this tracker’s settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この項目の編集画面でヘルスケアを設定してください。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在這個追蹤項目的編輯頁設定 Apple 健康。"
          }
        }
      }
    },
    "Health data updates automatically. Set up access in this tracker’s settings.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health data updates automatically. Set up access in this tracker’s settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアデータは自動で更新されます。読み取り設定はこの項目の編集画面で行えます。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "健康資料會自動更新，存取設定可在這個追蹤項目的編輯頁完成。"
          }
        }
      }
    },
