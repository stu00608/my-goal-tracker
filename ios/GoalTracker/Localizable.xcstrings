    "A full backup includes records, goal history and photos. Keep a copy somewhere safe. Backups are not encrypted.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A full backup includes records, goal history and photos. Keep a copy somewhere safe. Backups are not encrypted."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完整備份包含紀錄、目標歷史與照片，請妥善保存。備份檔未加密。"
          }
